# ---------------------------------------------------------------------------
# Copy to .env and adjust.  .env is git-ignored; .env.example is committed.
# Real environment variables override anything set here.
# Portal behaviour / filters / selectors live in config.yaml, not here.
# ---------------------------------------------------------------------------

# ---- API server (used by `python -m backend`) ----
VAHAN_HOST=127.0.0.1
VAHAN_PORT=8000
VAHAN_RELOAD=false
# Comma-separated allowed origins for the browser. "*" = any (fine for local).
# Set explicit origins if the frontend is hosted separately, e.g.
# VAHAN_CORS_ORIGINS=http://127.0.0.1:5679
VAHAN_CORS_ORIGINS=*
# true  = this server also serves the dashboard (single command).
# false = API only; run the frontend separately with `python -m tools.serve_frontend`.
VAHAN_SERVE_FRONTEND=true

# ---- standalone frontend server (used by `python -m tools.serve_frontend`) ----
FRONTEND_HOST=127.0.0.1
# Not 5173 - that's Vite's default and collides with other frontend projects
# (their dev server on ::1:5173 vs this one on 127.0.0.1:5173 makes "localhost"
# resolve to whichever bound the IPv6 side, which is confusing). Pick anything
# else free on your machine.
FRONTEND_PORT=5679
# Where the frontend should send API calls. Leave blank to use frontend/config.js.
# For the two-server setup, point it at the backend - use 127.0.0.1, not
# "localhost" (Windows can resolve that to ::1, which nothing here listens on):
# VAHAN_API_BASE=http://127.0.0.1:8000
VAHAN_API_BASE=

# ---- optional overrides of config.yaml ----
# VAHAN_PORTAL_URL=https://analytics.parivahan.gov.in/analytics/vahanpublicreport?lang=en
# VAHAN_HEADLESS=true
# VAHAN_SLOW_MO=0
# VAHAN_CAPTCHA_MANUAL_FALLBACK=true
# VAHAN_OUTPUT_DIR=output

# ---- email delivery of the run summary (PDD Step 8.2 / 8.3) ----
# Not wired into a flow yet - these are the placeholders the email step will use.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated recipient list.
SMTP_TO=
SMTP_STARTTLS=true
