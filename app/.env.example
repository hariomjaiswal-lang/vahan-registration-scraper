# ---------------------------------------------------------------------------
# Copy to .env and adjust.  .env is git-ignored; .env.example is committed.
# Real environment variables override anything set here.
# Portal behaviour / filters / selectors live in config.yaml, not here.
# ---------------------------------------------------------------------------

# ---- API server + dashboard, one process (python -m backend / run-backend.cmd) ----
# Monolithic: this one server answers both the JSON API (/api/*) and serves
# the dashboard (everything else) on the same host/port - no separate
# frontend server or port to configure.
VAHAN_HOST=127.0.0.1
VAHAN_PORT=8000
VAHAN_RELOAD=false
# Comma-separated allowed origins for the browser. "*" is fine since the
# dashboard is same-origin here (one server, one port).
VAHAN_CORS_ORIGINS=*

# ---- optional overrides of config.yaml ----
# VAHAN_PORTAL_URL=https://analytics.parivahan.gov.in/analytics/vahanpublicreport?lang=en
# VAHAN_HEADLESS=true
# VAHAN_SLOW_MO=0
# VAHAN_CAPTCHA_MANUAL_FALLBACK=true
# VAHAN_OUTPUT_DIR=output

# ---- email delivery of the run summary (PDD Step 8.2 / 8.3) ----
# Every flow emails this summary automatically when it finishes. Leave blank
# to disable email entirely (the run still completes normally either way).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated recipient list.
SMTP_TO=
SMTP_STARTTLS=true
